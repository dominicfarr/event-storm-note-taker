# Copy to .env (gitignored) and adjust.

# Where Sessions are kept: one folder per Session, with its Recording and transcript.
EVENTSTORM_HOME=~/EventStorm

# The whisper.cpp model file `npm run dev` starts whisper-server with.
WHISPER_MODEL=~/models/whisper/ggml-small.en.bin

# whisper-server's port (its default, 8080, is often taken).
WHISPER_PORT=8178
